FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY api/ ./api/
RUN dotnet restore api/src/Ulric.BookingDesk.Api/Ulric.BookingDesk.Api.csproj
RUN dotnet publish api/src/Ulric.BookingDesk.Api/Ulric.BookingDesk.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["dotnet", "Ulric.BookingDesk.Api.dll"]
