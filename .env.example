# Demo configuration only. Do not put real payment handles, tokens, or mailbox passwords here.
# Copy to .env if you want docker compose to read these values. The app still runs with no .env file.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Sqlite is the zero-config default. Leave Provider as Sqlite for dotnet run and for compose.
Database__Provider=Sqlite
# Leave MySqlVersion empty to AutoDetect. Pin 5.7.39-mysql only if you want to skip detection.
Database__MySqlVersion=
ConnectionStrings__Default=Data Source=data/ulric.db

# MAMP MySQL 5.7 example only. Port 8889 is the MAMP default. root/root is the MAMP sample login, not a secret to reuse.
# Create the database first: CREATE DATABASE ulric CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ConnectionStrings__MySql=Server=127.0.0.1;Port=8889;Database=ulric;User=root;Password=root;CharSet=utf8mb4;SslMode=None;
# Database__Provider=MySql
# Desk__PublicBaseUrl=http://localhost:8888/grokbot/asp/ulric-booking-desk

# Docker Compose MySQL (service name mysql, port 3306). The demo password is ulric-demo.
# ConnectionStrings__MySql=Server=mysql;Port=3306;Database=ulric;User=ulric;Password=ulric-demo;CharSet=utf8mb4;SslMode=None;
# MYSQL_DATABASE=ulric
# MYSQL_USER=ulric
# MYSQL_PASSWORD=ulric-demo
# MYSQL_ROOT_PASSWORD=ulric-demo

Storage__Root=data
Desk__RemindersEnabled=true
Desk__ReminderIntervalSeconds=30
Desk__TimeZone=America/Los_Angeles
Desk__RequestExpiryHours=48
# Sample first-name bookings are off unless you set this to true. A live install stays empty of guests.
Desk__SeedSampleBookings=false
# Payment handles and host contact stay empty in the repo. Set them only on the machine that runs the desk.
Payments__PayPalHandle=
Payments__VenmoHandle=
Host__Phone=
Host__Email=
